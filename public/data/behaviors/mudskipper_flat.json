{
  "id": "mudskipper_flat",
  "tickHz": { "near": 5, "mid": 2, "far": 0.5 },
  "root": { "type": "selector", "children": [
    { "type": "sequence", "children": [
      { "type": "condition", "name": "player_within", "args": { "m": "$fleeDistance_m" } },
      { "type": "action", "name": "flee", "args": { "distance_m": "$fleeRun_m", "urgency": 1, "param": "escape" }, "interrupt": true }
    ]},
    { "type": "sequence", "children": [
      { "type": "condition", "name": "time_is", "args": { "v": "night" } },
      { "type": "condition", "name": "random_chance", "args": { "p": 0.85 } },
      { "type": "action", "name": "burrow", "args": { "seconds": "$nightBurrow_s" } }
    ]},
    { "type": "sequence", "children": [
      { "type": "condition", "name": "tide_is", "args": { "v": "rising" } },
      { "type": "condition", "name": "depth_above", "args": { "m": -0.03 } },
      { "type": "condition", "name": "random_chance", "args": { "p": 0.2 } },
      { "type": "action", "name": "burrow", "args": { "seconds": [120, 600] } }
    ]},
    { "type": "sequence", "children": [
      { "type": "condition", "name": "depth_above", "args": { "m": 0.02 } },
      { "type": "condition", "name": "length_above", "args": { "mm": 40 } },
      { "type": "action", "name": "move_to_waterline", "args": { "distance_m": 8 } }
    ]},
    { "type": "sequence", "children": [
      { "type": "condition", "name": "alert_above", "args": { "v": 0.5 } },
      { "type": "action", "name": "display", "args": { "param": "alert", "seconds": [1, 4] } }
    ]},
    { "type": "sequence", "children": [
      { "type": "condition", "name": "exposed", "args": {} },
      { "type": "random", "weights": [0.36, 0.22, 0.08, 0.2, 0.06, 0.04, 0.04], "children": [
        { "type": "action", "name": "rest", "args": { "seconds": "$restMean_s" } },
        { "type": "action", "name": "wander", "args": { "distance_m": "$crawlDistance_m", "stayNearHome_m": 5 } },
        { "type": "action", "name": "wander", "args": { "distance_m": "$hopDistance_m", "stayNearHome_m": 5 } },
        { "type": "action", "name": "forage", "args": { "seconds": [3, 10] } },
        { "type": "cooldown", "seconds": 90, "child": { "type": "action", "name": "move_to_deeper", "args": { "minDepth_m": 0.02 } } },
        { "type": "cooldown", "seconds": 45, "child": { "type": "action", "name": "display", "args": { "param": "inflate", "seconds": [2, 5] } } },
        { "type": "cooldown", "seconds": 120, "child": { "type": "action", "name": "burrow", "args": { "seconds": [8, 40] } } }
      ]}
    ]},
    { "type": "sequence", "children": [
      { "type": "condition", "name": "submerged", "args": {} },
      { "type": "selector", "children": [
        { "type": "sequence", "children": [
          { "type": "condition", "name": "length_above", "args": { "mm": 40 } },
          { "type": "random", "weights": [0.45, 0.15, 0.4], "children": [
            { "type": "action", "name": "rest", "args": { "seconds": "$restMean_s" } },
            { "type": "action", "name": "forage", "args": { "seconds": [2, 6] } },
            { "type": "action", "name": "move_to_waterline", "args": { "distance_m": 6 } }
          ]}
        ]},
        { "type": "random", "weights": [0.6, 0.3, 0.1], "children": [
          { "type": "action", "name": "rest", "args": { "seconds": "$restMean_s" } },
          { "type": "action", "name": "forage", "args": { "seconds": [2, 6] } },
          { "type": "action", "name": "move_to_waterline", "args": { "distance_m": 6 } }
        ]}
      ]}
    ]}
  ]}
}
