{
  "id": "squid_sand",
  "tickHz": { "near": 4, "mid": 1, "far": 0.4 },
  "root": { "type": "selector", "children": [
    { "type": "sequence", "children": [
      { "type": "condition", "name": "player_within", "args": { "m": "$fleeDistance_m" } },
      { "type": "action", "name": "flee", "args": { "distance_m": 0.8, "urgency": 1 }, "interrupt": true }
    ]},
    { "type": "sequence", "children": [
      { "type": "condition", "name": "depth_below", "args": { "m": 0.06 } },
      { "type": "action", "name": "move_to_deeper", "args": { "minDepth_m": 0.15 } }
    ]},
    { "type": "sequence", "children": [
      { "type": "condition", "name": "alert_above", "args": { "v": 0.45 } },
      { "type": "action", "name": "display", "args": { "param": "freeze", "seconds": [3, 8] } }
    ]},
    { "type": "sequence", "children": [
      { "type": "condition", "name": "time_is", "args": { "v": "day" } },
      { "type": "random", "weights": [0.72, 0.12, 0.06, 0.1], "children": [
        { "type": "action", "name": "burrow", "args": { "seconds": "$buryDay_s" } },
        { "type": "action", "name": "rest", "args": { "seconds": "$restMean_s" } },
        { "type": "action", "name": "wander", "args": { "distance_m": [0.05, 0.15], "stayNearHome_m": 1.5 } },
        { "type": "action", "name": "forage", "args": { "seconds": [6, 12] } }
      ]}
    ]},
    { "type": "random", "weights": [0.18, 0.32, 0.36, 0.14], "children": [
      { "type": "action", "name": "rest", "args": { "seconds": "$restMean_s" } },
      { "type": "action", "name": "wander", "args": { "distance_m": "$wanderDistance_m", "stayNearHome_m": 2.5 } },
      { "type": "action", "name": "forage", "args": { "seconds": [6, 14] } },
      { "type": "action", "name": "burrow", "args": { "seconds": [20, 60] } }
    ]}
  ]}
}
