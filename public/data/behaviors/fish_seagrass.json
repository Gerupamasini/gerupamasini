{
  "id": "fish_seagrass",
  "tickHz": { "near": 5, "mid": 2, "far": 0.5 },
  "root": { "type": "selector", "children": [
    { "type": "sequence", "children": [
      { "type": "condition", "name": "player_within", "args": { "m": "$fleeDistance_m" } },
      { "type": "action", "name": "flee", "args": { "distance_m": 0.8, "urgency": 1 }, "interrupt": true }
    ]},
    { "type": "sequence", "children": [
      { "type": "condition", "name": "depth_below", "args": { "m": 0.06 } },
      { "type": "action", "name": "move_to_deeper", "args": { "minDepth_m": 0.18 } }
    ]},
    { "type": "sequence", "children": [
      { "type": "condition", "name": "alert_above", "args": { "v": 0.45 } },
      { "type": "action", "name": "display", "args": { "param": "hide", "seconds": [6, 12] } }
    ]},
    { "type": "sequence", "children": [
      { "type": "condition", "name": "time_is", "args": { "v": "night" } },
      { "type": "random", "weights": [0.85, 0.15], "children": [
        { "type": "action", "name": "special", "args": { "param": "sleep" } },
        { "type": "action", "name": "rest", "args": { "seconds": 20 } }
      ]}
    ]},
    { "type": "random", "weights": [0.34, 0.32, 0.22, 0.12], "children": [
      { "type": "action", "name": "rest", "args": { "seconds": "$restMean_s" } },
      { "type": "action", "name": "forage", "args": { "seconds": [8, 16] } },
      { "type": "action", "name": "wander", "args": { "distance_m": "$wanderDistance_m", "stayNearHome_m": 3 } },
      { "type": "cooldown", "seconds": 25, "child": { "type": "action", "name": "special", "args": { "param": "hide" } } }
    ]}
  ]}
}
