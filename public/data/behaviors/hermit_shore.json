    { "type": "random", "weights": [0.35, 0.35, 0.22, 0.08], "children": [
      { "type": "action", "name": "rest", "args": { "seconds": "$restMean_s" } },
      { "type": "action", "name": "wander", "args": { "distance_m": [0.1, 0.4], "stayNearHome_m": 1.5 } },
      { "type": "action", "name": "forage", "args": { "seconds": [4, 10] } },
