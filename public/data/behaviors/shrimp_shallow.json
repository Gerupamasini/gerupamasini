{
  "id": "shrimp_shallow",
  "tickHz": { "near": 5, "mid": 2, "far": 0.5 },
  "root": { "type": "selector", "children": [
    { "type": "sequence", "children": [
      { "type": "condition", "name": "player_within", "args": { "m": "$fleeDistance_m" } },
      { "type": "action", "name": "flee", "args": { "distance_m": 0.8, "urgency": 1, "param": "tail_flip" }, "interrupt": true }
    ]},
    { "type": "sequence", "children": [
      { "type": "condition", "name": "depth_below", "args": { "m": 0.02 } },
      { "type": "action", "name": "move_to_deeper", "args": { "minDepth_m": 0.1 } }
    ]},
    { "type": "random", "weights": [0.5, 0.3, 0.2], "children": [
      { "type": "action", "name": "rest", "args": { "seconds": "$restMean_s" } },
      { "type": "action", "name": "wander", "args": { "distance_m": [0.2, 0.8], "stayNearHome_m": 3 } },
      { "type": "action", "name": "forage", "args": { "seconds": [3, 8] } }
    ]}
  ]}
}
