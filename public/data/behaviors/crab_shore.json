{
  "id": "crab_shore",
  "tickHz": { "near": 4, "mid": 1, "far": 0.3 },
  "root": { "type": "selector", "children": [
    { "type": "sequence", "children": [
      { "type": "condition", "name": "player_within", "args": { "m": "$fleeDistance_m" } },
      { "type": "action", "name": "flee", "args": { "distance_m": "$runDistance_m", "urgency": 1, "param": "scuttle" }, "interrupt": true }
    ]},
    { "type": "sequence", "children": [
      { "type": "condition", "name": "depth_below", "args": { "m": 0.015 } },
      { "type": "action", "name": "move_to_deeper", "args": { "minDepth_m": 0.05 } }
    ]},
    { "type": "sequence", "children": [
      { "type": "condition", "name": "alert_above", "args": { "v": 0.45 } },
      { "type": "cooldown", "seconds": 12, "child": { "type": "action", "name": "display", "args": { "param": "claw_display", "seconds": [2, 4] } } }
    ]},
    { "type": "random", "weights": [0.45, 0.3, 0.25], "children": [
      { "type": "action", "name": "rest", "args": { "seconds": "$restMean_s" } },
      { "type": "action", "name": "wander", "args": { "distance_m": [0.15, 0.6], "stayNearHome_m": 2 } },
      { "type": "action", "name": "forage", "args": { "seconds": [3, 7] } }
    ]}
  ]}
}
