{
  "id": "snail_crawl",
  "tickHz": { "near": 1, "mid": 0.4, "far": 0.15 },
  "root": { "type": "selector", "children": [
    { "type": "sequence", "children": [
      { "type": "condition", "name": "player_within", "args": { "m": "$fleeDistance_m" } },
      { "type": "action", "name": "flee", "args": { "distance_m": 0.05, "urgency": 0.5, "param": "withdraw" }, "interrupt": true }
    ]},
    { "type": "sequence", "children": [
      { "type": "condition", "name": "depth_below", "args": { "m": 0.012 } },
      { "type": "action", "name": "move_to_deeper", "args": { "minDepth_m": 0.03 } }
    ]},
    { "type": "random", "weights": [0.25, 0.4, 0.2, 0.15], "children": [
      { "type": "action", "name": "rest", "args": { "seconds": "$restMean_s" } },
      { "type": "action", "name": "wander", "args": { "distance_m": [0.05, 0.25], "stayNearHome_m": 1 } },
      { "type": "action", "name": "forage", "args": { "seconds": [5, 12] } },
      { "type": "action", "name": "burrow", "args": { "seconds": [20, 60] } }
    ]}
  ]}
}
