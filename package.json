{
  "name": "yamame-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Photoreal Yamame (Oncorhynchus masou masou) 3D model for Three.js — procedural build pipeline, viewer and tests",
  "engines": { "node": ">=22" },
  "scripts": {
    "build:assets": "node tools/build-assets/build.mjs",
    "serve": "node tools/headless/serve.mjs",
    "snapshot": "node tools/headless/render-snapshot.mjs",
    "test": "node --test tests/unit tests/asset"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@napi-rs/canvas": "1.0.9",
    "pngjs": "7.0.0",
    "playwright-core": "1.63.0",
    "gltf-validator": "2.0.0-dev.3.10"
  }
}
